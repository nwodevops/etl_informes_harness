<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_create_stg_windows</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Windows diseño: Reset H2 → STG_* H2 → ensure DW Oracle (CREATE si faltan) → Success</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/09/22 12:25:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/22 12:25:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Reset H2 clean</name>
      <description>start H2 mem + DDL (00_reset.sql + 01_schema.sql)</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
call h2\scripts\reset_and_create.bat
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>176</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Python create STG</name>
      <description>inputs.yaml → CREATE TABLE STG_* en H2</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
set "PY=.venv\Scripts\python.exe"
if not exist "%PY%" set "PY=python"
"%PY%" python\stg\create_stg.py
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Python ensure DW</name>
      <description>oracle_dw: CREATE DW_INF_* si no existen (sin DROP)</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>@echo off
cd /d "%PROJECT_HOME%"
set "PY=.venv\Scripts\python.exe"
if not exist "%PY%" set "PY=python"
"%PY%" python\stg\ensure_dw_tables.py
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>528</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description>H2 vivo + STG_* + DW_* aseguradas</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>704</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>Python create STG</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Python create STG</from>
      <to>Python ensure DW</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Python ensure DW</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <height>100</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>Windows — DISEÑO (primera vez / DW vacío).
1) Play wf_create_stg_windows
2) Luego siempre wf_main_windows (TRUNCATE + carga)
Equivalente Linux: wf_create_stg.hwf → wf_main.hwf</note>
      <width>640</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
