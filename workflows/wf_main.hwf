      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/create_stg.py
</script>
      <name>Python create STG</name>
      <description>inputs.yaml → CREATE TABLE STG_*</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>336</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/stage_rdata.py
</script>
      <name>Stage RData</name>
      <description>RData → STG_INF_CONSOL</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>496</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/stage_mysql.py --soft
</script>
      <name>Stage MySQL soft</name>
      <description>MySQL → STG_INF_CONSOL_FORM (no falla el wf si MySQL cae)</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/main.py
</script>
      <name>Run Python</name>
      <description>→ DW_INF_CONSOL_RDATA + DW_INF_CONSOL_FORM (FORM siempre, aunque vacío)</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>816</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/ddl_csep_informes.py --soft
</script>
      <name>DDL CSEP soft</name>
      <description>DROP+CREATE DW_INF_CSEP_INFORMES_VIEW en oracle_dw (stub si SISUD cae)</description>
      <type>SHELL</type>
      <attributes/>
      <xloc>976</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>pl_csep_informes</name>
      <description>TableInput vista → TableOutput DW_INF_CSEP_INFORMES_VIEW</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/pl_csep_informes.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>1136</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>1296</xloc>
      <yloc>192</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>Python create STG</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Python create STG</from>
      <to>Stage RData</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Stage RData</from>
      <to>Stage MySQL soft</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Stage MySQL soft</from>
      <to>Run Python</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Run Python</from>
      <to>DDL CSEP soft</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DDL CSEP soft</from>
      <to>pl_csep_informes</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>pl_csep_informes</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>pl_csep_informes</from>
      <to>Success</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>Destino final: DW_INF_CONSOL_RDATA + DW_INF_CONSOL_FORM + DW_INF_CSEP_INFORMES_VIEW. MySQL/SISUD soft: tablas vacías/stub si cae el input.</note>
